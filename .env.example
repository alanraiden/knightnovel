# MongoDB - new database in the same cluster as the existing site
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/knightnovel?retryWrites=true&w=majority
MONGODB_DB=knightnovel

# NextAuth
NEXTAUTH_SECRET=replace-with-a-random-32-byte-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://knightnovel.com

# Vercel Blob — for sticker uploads (Vercel dashboard → Storage → Create Database → Blob)
BLOB_READ_WRITE_TOKEN=
